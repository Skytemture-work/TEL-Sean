[Unit]
Description=Configure and bring up the robot CAN bus (can0)
BindsTo=sys-subsystem-net-devices-can0.device
After=sys-subsystem-net-devices-can0.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/ip link set dev can0 down
ExecStart=/usr/sbin/ip link set dev can0 type can bitrate 500000
ExecStart=/usr/sbin/ip link set dev can0 up
ExecStop=-/usr/sbin/ip link set dev can0 down

[Install]
WantedBy=multi-user.target
